<?xml version="1.0" encoding="utf-8"?>
<!-- Android Auto Backup (Android 11 and lower): back up the database and settings. -->
<full-backup-content>
    <include domain="database" path="." />
    <include domain="sharedpref" path="." />
    <include domain="file" path="datastore/" />
    <!-- Logo and signature, so a restored database does not point at missing images. -->
    <include domain="file" path="branding/" />
</full-backup-content>
